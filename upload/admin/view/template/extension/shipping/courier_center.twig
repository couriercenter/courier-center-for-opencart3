{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-courier-center" data-toggle="tooltip" title="{{ button_save|e }}" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save|e }}</button>
        <a href="{{ cancel|e }}" data-toggle="tooltip" title="{{ button_cancel|e }}" class="btn btn-default"><i class="fa fa-reply"></i> {{ button_cancel|e }}</a>
      </div>
      <h1>{{ heading_title|e }} <small>v{{ version|e }}</small></h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href|e }}">{{ breadcrumb.text|e }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning|e }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-truck"></i> Courier Center — Ρυθμίσεις</h3></div>
      <div class="panel-body">
        <form action="{{ action|e }}" method="post" enctype="multipart/form-data" id="form-courier-center" class="form-horizontal">

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_status|e }}</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_status" class="form-control">
                <option value="1"{% if status == '1' %} selected{% endif %}>{{ text_enabled|e }}</option>
                <option value="0"{% if status != '1' %} selected{% endif %}>{{ text_disabled|e }}</option>
              </select>
            </div>
          </div>

          <hr><h4 style="padding-left:15px">💶 Μέθοδος Αποστολής (Checkout)</h4>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_cost|e }}</label>
            <div class="col-sm-10">
              <div class="input-group" style="max-width:220px;">
                <input type="text" name="shipping_courier_center_cost" value="{{ cost|e }}" class="form-control" placeholder="0.00" />
                <span class="input-group-addon">€</span>
              </div>
              <p class="help-block">Σταθερό κόστος αποστολής που εμφανίζεται στον πελάτη στο checkout.</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_cod_fee|e }}</label>
            <div class="col-sm-10">
              <div class="input-group" style="max-width:220px;">
                <input type="text" name="shipping_courier_center_cod_fee" value="{{ cod_fee|e }}" class="form-control" placeholder="0.00" />
                <span class="input-group-addon">€</span>
              </div>
              <p class="help-block">Επιπλέον χρέωση για πληρωμή με αντικαταβολή. Εμφανίζεται ως ξεχωριστή επιλογή «Courier Center — Αντικαταβολή» στο checkout. Άφησε 0 για να μην εμφανίζεται.</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_tax_class|e }}</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_tax_class_id" class="form-control" style="max-width:320px;">
                <option value="0">{{ text_none|e }}</option>
                {% for tax_class in tax_classes %}
                <option value="{{ tax_class.tax_class_id|e }}"{% if tax_class.tax_class_id == tax_class_id %} selected{% endif %}>{{ tax_class.title|e }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_geo_zone|e }}</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_geo_zone_id" class="form-control" style="max-width:320px;">
                <option value="0">{{ text_all_zones|e }}</option>
                {% for geo_zone in geo_zones %}
                <option value="{{ geo_zone.geo_zone_id|e }}"{% if geo_zone.geo_zone_id == geo_zone_id %} selected{% endif %}>{{ geo_zone.name|e }}</option>
                {% endfor %}
              </select>
              <p class="help-block">Περιόρισε τη μέθοδο σε συγκεκριμένη γεωγραφική ζώνη (π.χ. μόνο Ελλάδα). Άφησε «Όλες οι Ζώνες» για παντού.</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_sort_order|e }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_courier_center_sort_order" value="{{ sort_order|e }}" class="form-control" style="max-width:120px;" />
            </div>
          </div>

          <hr><h4 style="padding-left:15px">Στοιχεία API</h4>

          {% for field, label in {'user_alias': entry_user_alias, 'credential_value': entry_credential_value, 'api_key': entry_api_key, 'billing_account': entry_billing_account} %}
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ label|e }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_courier_center_{{ field|e }}" value="{{ attribute(_context, field)|e }}" class="form-control" autocomplete="off" />
            </div>
          </div>
          {% endfor %}

          <hr>
          <div style="padding: 10px 15px 16px;">
            <button type="button" id="cc-autofill-btn" class="btn btn-info"><i class="fa fa-search"></i> Test &amp; Auto-fill στοιχεία αποστολέα</button>
            <span id="cc-autofill-status" style="margin-left:12px; font-style:italic;"></span>
            <div id="cc-autofill-notice" style="display:none; margin-top:10px; padding:10px 14px; background:#dff0d8; border-left:4px solid #3c763d; border-radius:3px;">
              <i class="fa fa-check-circle"></i> <strong>Στοιχεία από Courier Center API</strong>: τα πεδία συμπληρώθηκαν και αποθηκεύτηκαν (οι υπόλοιπες ρυθμίσεις δεν άλλαξαν).
            </div>
          </div>

          <h4 style="padding-left:15px">Στοιχεία Αποστολέα</h4>

          {% for field, label in {'shipper_name': entry_shipper_name, 'shipper_address': entry_shipper_address, 'shipper_postcode': entry_shipper_postcode, 'shipper_city': entry_shipper_city, 'shipper_phone': entry_shipper_phone} %}
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ label|e }}</label>
            <div class="col-sm-10">
              <input type="text" id="cc_field_{{ field|e }}" name="shipping_courier_center_{{ field|e }}" value="{{ attribute(_context, field)|e }}" class="form-control" />
            </div>
          </div>
          {% endfor %}

          <hr><h4 style="padding-left:15px">Tracking &amp; Email</h4>

          <div class="form-group">
            <label class="col-sm-2 control-label">Tracking URL</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_courier_center_tracking_url" value="{{ tracking_url|e }}" class="form-control" placeholder="https://www.courier.gr/track/result?tracknr={% verbatim %}{{tracking}}{% endverbatim %}" />
              <p class="help-block">Χρησιμοποίησε <code>{% verbatim %}{{tracking}}{% endverbatim %}</code> ως placeholder για τον αριθμό αποστολής.</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">Tracking σε emails</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_email_tracking_enabled" class="form-control" style="width:auto">
                <option value="1"{% if email_tracking_enabled == '1' %} selected{% endif %}>Ενεργό — αποστολή tracking link στον πελάτη</option>
                <option value="0"{% if email_tracking_enabled == '0' %} selected{% endif %}>Ανενεργό</option>
              </select>
            </div>
          </div>

          <hr><h4 style="padding-left:15px">BOX NOW</h4>

          <div class="form-group">
            <label class="col-sm-2 control-label">BOX NOW Checkout</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_boxnow_enabled" class="form-control" style="width:auto">
                <option value="0"{% if boxnow_enabled != '1' %} selected{% endif %}>Ανενεργό</option>
                <option value="1"{% if boxnow_enabled == '1' %} selected{% endif %}>Ενεργό — εμφάνιση BOX NOW widget στο checkout</option>
              </select>
              <p class="help-block">Επιτρέπει στον πελάτη να επιλέξει παράδοση σε BOX NOW Locker κατά το checkout.</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">Προεπιλεγμένο BOX NOW</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_boxnow_default_selected" class="form-control" style="width:auto">
                <option value="0"{% if boxnow_default_selected != '1' %} selected{% endif %}>Όχι — ο πελάτης το ενεργοποιεί χειροκίνητα</option>
                <option value="1"{% if boxnow_default_selected == '1' %} selected{% endif %}>Ναι — τσεκαρισμένο &amp; κλειδωμένο όταν επιλεγεί μέθοδος Courier Center</option>
              </select>
              <p class="help-block">Όταν είναι «Ναι», το BOX NOW εμφανίζεται ήδη τσεκαρισμένο και κλειδωμένο μόλις ο πελάτης επιλέξει μέθοδο Courier Center. Για να το αφαιρέσει, επιλέγει άλλον τρόπο μεταφοράς.</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">Εμφάνιση σε μεθόδους</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_boxnow_shipping_methods[]" multiple class="form-control" style="max-width:320px; min-height:120px;">
                {% for m in shipping_methods_list %}
                <option value="{{ m.code|e }}"{% if m.code in boxnow_shipping_methods %} selected{% endif %}>{{ m.name|e }}</option>
                {% endfor %}
              </select>
              <p class="help-block">Σε ποιες μεθόδους αποστολής θα εμφανίζεται το BOX NOW widget στο checkout. Κράτα <strong>Ctrl</strong> για πολλαπλή επιλογή. (Προεπιλογή: Courier Center)</p>
            </div>
          </div>

          <hr><h4 style="padding-left:15px">🚚 Μέθοδοι αποστολής που διαχειρίζεται το plugin</h4>

          <div class="form-group">
            <label class="col-sm-2 control-label">Διαχειρίσιμες μέθοδοι</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_handled_shipping_methods[]" multiple class="form-control" style="max-width:320px; min-height:120px;">
                {% for m in shipping_methods_list %}
                <option value="{{ m.code|e }}"{% if m.code in handled_shipping_methods %} selected{% endif %}>{{ m.name|e }}</option>
                {% endfor %}
              </select>
              <p class="help-block">Voucher Courier Center (αυτόματα / μαζικά / χειροκίνητα) δημιουργείται <strong>μόνο</strong> για παραγγελίες με αυτές τις μεθόδους — οι υπόλοιπες (π.χ. άλλος courier) αγνοούνται. Κράτα <strong>Ctrl</strong> για πολλαπλή επιλογή. <strong>Αν δεν επιλέξεις καμία, το plugin διαχειρίζεται ΟΛΕΣ τις παραγγελίες.</strong></p>
            </div>
          </div>

          <hr><h4 style="padding-left:15px">Εκτύπωση Voucher</h4>

          <div class="form-group">
            <label class="col-sm-2 control-label">Template (κανονικά)</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_print_template" class="form-control" style="max-width:420px">
                {% for key, label in {'pdf': 'A4 — 3 θέσεις, μη προεκτυπωμένο', 'clean': 'A4 — 3 θέσεις, προεκτυπωμένο', 'singlepdf_100x150_4up': 'A4 — 4 θέσεις 100×150mm', 'singlepdf': 'Θερμικός 205×100mm, μη προεκτυπωμένο', 'singleclean': 'Θερμικός 205×100mm, προεκτυπωμένο', 'singlepdf_100x150': 'Θερμικός 100×150mm', 'singlepdf_100x170': 'Θερμικός 100×170mm'} %}
                <option value="{{ key|e }}"{% if print_template == key %} selected{% endif %}>{{ label|e }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">Template (BOX NOW)</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_print_template_boxnow" class="form-control" style="max-width:420px">
                <option value="singlepdf_100x150_4up"{% if print_template_boxnow == 'singlepdf_100x150_4up' %} selected{% endif %}>A4 — 4 θέσεις 100×150mm (default)</option>
                <option value="singlepdf_100x150"{% if print_template_boxnow == 'singlepdf_100x150' %} selected{% endif %}>Θερμικός 100×150mm</option>
              </select>
            </div>
          </div>

          <hr><h4 style="padding-left:15px">Αυτόματη Ολοκλήρωση</h4>

          <div class="form-group">
            <label class="col-sm-2 control-label">Σε παράδοση → status</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_auto_complete_status_id" class="form-control" style="max-width:320px">
                <option value="0"{% if auto_complete_status_id == '0' %} selected{% endif %}>Ανενεργό</option>
                {% for order_status in order_statuses %}
                <option value="{{ order_status.order_status_id|e }}"{% if auto_complete_status_id == order_status.order_status_id %} selected{% endif %}>{{ order_status.name|e }}</option>
                {% endfor %}
              </select>
              <p class="help-block">Όταν μια αποστολή παραδοθεί, η παραγγελία αλλάζει αυτόματα σε αυτό το status (π.χ. «Complete»). Άφησε «Ανενεργό» για να μην αλλάζει.</p>
            </div>
          </div>

          <hr><h4 style="padding-left:15px">🤖 Αυτόματη Δημιουργία Voucher</h4>

          <div class="form-group">
            <label class="col-sm-2 control-label">Ενεργοποίηση</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_auto_create_enabled" class="form-control" style="width:auto">
                <option value="0"{% if auto_create_enabled != '1' %} selected{% endif %}>Ανενεργό</option>
                <option value="1"{% if auto_create_enabled == '1' %} selected{% endif %}>Ενεργό</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">Status που πυροδοτεί</label>
            <div class="col-sm-10">
              <select name="shipping_courier_center_auto_create_status_id" class="form-control" style="max-width:320px">
                <option value="0"{% if auto_create_status_id == '0' %} selected{% endif %}>— Επίλεξε status —</option>
                {% for order_status in order_statuses %}
                <option value="{{ order_status.order_status_id|e }}"{% if auto_create_status_id == order_status.order_status_id %} selected{% endif %}>{{ order_status.name|e }}</option>
                {% endfor %}
              </select>
              <p class="help-block">Μόλις μια παραγγελία περάσει σε αυτό το status (π.χ. «Processing»), δημιουργείται αυτόματα voucher (Επόμενη Μέρα, με αυτόματο εντοπισμό BOX NOW), εφόσον δεν υπάρχει ήδη ενεργό voucher.</p>
            </div>
          </div>

          <hr><h4 style="padding-left:15px">⏱️ Αυτόματη ενημέρωση κατάστασης (cron)</h4>

          <div class="form-group">
            <label class="col-sm-2 control-label">Τελευταία εκτέλεση</label>
            <div class="col-sm-10">
              <p class="form-control-static">{{ cron_last_run|e }} <span class="text-muted">· επόμενη: {{ cron_next_run|e }}</span></p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">Τρόπος 1 — cron (CLI)</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" readonly class="form-control" id="cc-cron-cli" value="{{ cron_cli|e }}" />
                <span class="input-group-btn"><button type="button" class="btn btn-default cc-copy" data-target="cc-cron-cli" title="Αντιγραφή"><i class="fa fa-copy"></i></button></span>
              </div>
              <p class="help-block">Στο cPanel → Cron Jobs: κάθε 2 ώρες (<code>0 */2 * * *</code>) με αυτή την εντολή. Αν η εντολή <code>php</code> δεν βρίσκεται, ρώτησε τον πάροχο για τη διαδρομή της PHP (π.χ. <code>/usr/local/bin/php</code>).</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">Τρόπος 2 — URL</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" readonly class="form-control" id="cc-cron-url" value="{{ cron_url|e }}" />
                <span class="input-group-btn">
                  <button type="button" class="btn btn-default cc-copy" data-target="cc-cron-url" title="Αντιγραφή"><i class="fa fa-copy"></i></button>
                  <button type="button" class="btn btn-warning" id="cc-cron-key-btn" title="Νέο κλειδί"><i class="fa fa-refresh"></i></button>
                </span>
              </div>
              <p class="help-block">Για hosting χωρίς cron CLI ή για υπηρεσίες όπως το cron-job.org: κάλεσε αυτό το URL κάθε 2 ώρες. Κράτα το κλειδί μυστικό· με «Νέο κλειδί» το παλιό URL σταματά να δουλεύει.</p>
            </div>
          </div>
        </form>

        <hr>
        <div style="padding:0 15px 20px; display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
          <a href="{{ url_docs|e }}" class="btn btn-primary btn-sm"><i class="fa fa-book"></i> Οδηγίες χρήσης</a>
          <a href="{{ url_bug_report|e }}" class="btn btn-warning btn-sm"><i class="fa fa-bug"></i> Αναφορά Προβλήματος</a>
          <button type="button" id="cc-update-check" class="btn btn-info btn-sm"><i class="fa fa-cloud-download"></i> Έλεγχος για ενημερώσεις</button>
          <button type="button" id="cc-repair-btn" class="btn btn-default btn-sm"><i class="fa fa-wrench"></i> Επιδιόρθωση εγκατάστασης</button>
          <button type="button" id="cc-clear-btn" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i> Καθαρισμός ρυθμίσεων</button>
          <span id="cc-tools-status" style="font-style:italic;"></span>
        </div>
        <div id="cc-update-box" style="padding:0 15px 16px; display:none;"></div>
      </div>
    </div>
  </div>
</div>
<script>
(function () {
  var URLS = {
    autofill: {{ url_autofill|json_encode }},
    clear: {{ url_clearSettings|json_encode }},
    repair: {{ url_repair|json_encode }},
    cronKey: {{ url_regenerateCronKey|json_encode }},
    updateCheck: {{ url_update_check|json_encode }},
    updateApply: {{ url_update_apply|json_encode }}
  };
  var EXPIRED = 'Η σύνδεση έληξε ή ο server απάντησε με σφάλμα. Κάνε ανανέωση της σελίδας (F5) και ξαναδοκίμασε.';

  function $(id) { return document.getElementById(id); }
  function post(url, params) {
    return fetch(url, {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: new URLSearchParams(params || {}).toString()})
      .then(function (r) { return r.text(); })
      .then(function (t) { try { return JSON.parse(t); } catch (e) { return {success: false, error: EXPIRED}; } })
      .catch(function (e) { return {success: false, error: String(e)}; });
  }
  function busy(btn, on, html) {
    if (on) { btn.setAttribute('data-orig', btn.innerHTML); btn.disabled = true; btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> ' + html; }
    else { btn.disabled = false; btn.innerHTML = btn.getAttribute('data-orig'); }
  }
  function status(text, ok) { var s = $('cc-tools-status'); s.textContent = text; s.style.color = ok ? '#3c763d' : '#a94442'; }
  function box(type, text) {
    var b = $('cc-update-box'); b.innerHTML = ''; b.style.display = 'block';
    var d = document.createElement('div'); d.className = 'alert alert-' + type; d.textContent = text; b.appendChild(d); return b;
  }

  // Test & Auto-fill
  $('cc-autofill-btn').addEventListener('click', function () {
    var btn = this, form = $('form-courier-center');
    busy(btn, true, 'Παρακαλώ περιμένετε...');
    $('cc-autofill-notice').style.display = 'none';
    $('cc-autofill-status').textContent = 'Δημιουργία και ακύρωση test αποστολής...';
    var p = {};
    ['user_alias', 'credential_value', 'api_key', 'billing_account'].forEach(function (k) {
      p[k] = form.querySelector('[name="shipping_courier_center_' + k + '"]').value;
    });
    post(URLS.autofill, p).then(function (r) {
      busy(btn, false);
      var st = $('cc-autofill-status');
      if (!r.success) { st.style.color = '#a94442'; st.textContent = '❌ ' + (r.error || 'Άγνωστο σφάλμα'); return; }
      ['shipper_name', 'shipper_address', 'shipper_postcode', 'shipper_city', 'shipper_phone'].forEach(function (k) {
        if (r[k]) { $('cc_field_' + k).value = r[k]; }
      });
      st.style.color = '#a94442';
      st.textContent = r.warning ? '⚠️ ' + r.warning : '';
      $('cc-autofill-notice').style.display = 'block';
    });
  });

  // Copy buttons (cron)
  Array.prototype.forEach.call(document.querySelectorAll('.cc-copy'), function (b) {
    b.addEventListener('click', function () { var i = $(b.getAttribute('data-target')); i.select(); try { document.execCommand('copy'); } catch (e) {} });
  });

  // New cron key
  $('cc-cron-key-btn').addEventListener('click', function () {
    if (!confirm('Νέο κλειδί cron; Το παλιό URL θα σταματήσει να δουλεύει.')) return;
    post(URLS.cronKey).then(function (r) { if (r.success) { $('cc-cron-url').value = r.cron_url; status('✓ Νέο κλειδί cron.', true); } else { status('❌ ' + (r.error || 'Σφάλμα'), false); } });
  });

  // Repair
  $('cc-repair-btn').addEventListener('click', function () {
    var btn = this; busy(btn, true, 'Επιδιόρθωση...');
    post(URLS.repair).then(function (r) { busy(btn, false); r.success ? status('✓ ' + (r.done || []).join(' · '), true) : status('❌ ' + (r.error || 'Σφάλμα'), false); });
  });

  // Clear settings
  $('cc-clear-btn').addEventListener('click', function () {
    if (!confirm('Είσαι σίγουρος; Θα διαγραφούν ΟΛΕΣ οι ρυθμίσεις Courier Center.')) return;
    post(URLS.clear).then(function (r) { r.success ? status('✓ Οι ρυθμίσεις διαγράφηκαν. Ανανέωσε τη σελίδα.', true) : status('❌ ' + (r.error || 'Σφάλμα'), false); });
  });

  // Updates (check -> apply -> finish with the new code)
  $('cc-update-check').addEventListener('click', function () {
    var btn = this; busy(btn, true, 'Έλεγχος...');
    post(URLS.updateCheck).then(function (d) {
      busy(btn, false);
      if (!d.success) { box('danger', '❌ ' + (d.error || 'Σφάλμα')); return; }
      if (!d.update_available) { box('info', '✅ Έχεις την τελευταία έκδοση (' + d.current + ').'); return; }
      var b = box('success', '🆕 Διαθέσιμη νέα έκδοση ' + d.latest + ' (τρέχουσα: ' + d.current + ')');
      var ap = document.createElement('button'); ap.type = 'button'; ap.className = 'btn btn-success btn-sm'; ap.innerHTML = '<i class="fa fa-download"></i> Ενημέρωση τώρα';
      var msg = document.createElement('span'); msg.style.marginLeft = '10px';
      b.appendChild(ap); b.appendChild(msg);
      ap.addEventListener('click', function () {
        if (!confirm('Να γίνει ενημέρωση στην έκδοση ' + d.latest + ';')) return;
        busy(ap, true, 'Ενημέρωση...');
        post(URLS.updateApply).then(function (u) {
          if (!u.success) { busy(ap, false); msg.textContent = '❌ ' + (u.error || 'Σφάλμα'); return; }
          post(u.finish_url).then(function (f) {
            busy(ap, false);
            msg.textContent = f.success ? '✅ ' + u.message : '⚠️ ' + u.message + ' — πάτα «Επιδιόρθωση εγκατάστασης».';
          });
        });
      });
    });
  });
})();
</script>
