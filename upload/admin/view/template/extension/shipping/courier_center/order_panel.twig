{# Courier Center tab of the admin order page. Values arrive decoded from the controller and are escaped here. #}
<div id="cc-panel" style="max-width:560px;">
  <style>
    #cc-panel .cc-info-box { background:#e7f5e9; border-left:4px solid #46b450; padding:12px; border-radius:3px; margin-bottom:10px; }
    #cc-panel .cc-info-box table { width:100%; font-size:13px; }
    #cc-panel .cc-info-box td { padding:3px 0; vertical-align:top; }
    #cc-panel .cc-info-box td:first-child { color:#555; width:120px; }
    #cc-panel .cc-voided { background:#fce8e6; border-left:4px solid #dc3232; padding:12px; border-radius:3px; margin-bottom:10px; }
    #cc-panel .cc-status { padding:8px 10px; border-left:4px solid #2271b1; background:#f0f6fc; border-radius:3px; margin:8px 0; font-size:12px; }
    #cc-panel .cc-status.cc-delivered { background:#e7f5e9; border-left-color:#46b450; }
    #cc-panel .cc-status.cc-failed { background:#fff3cd; border-left-color:#dba617; }
    #cc-panel .cc-status.cc-returned { background:#fce8e6; border-left-color:#dc3232; }
    #cc-panel .cc-return-awb { margin-top:8px; padding:8px; border-top:1px dashed #b8d4b8; font-size:12px; }
    #cc-panel .cc-locker-box { background:#f0faf2; border:1px solid #7bc47f; border-radius:3px; padding:8px 10px; margin:8px 0; font-size:12px; }
    #cc-panel .cc-form-section { border:1px solid #ddd; border-radius:4px; padding:10px; margin:8px 0; background:#f9f9f9; }
    #cc-panel .cc-form-section > .cc-label { font-weight:600; display:block; margin-bottom:6px; font-size:13px; }
    #cc-panel .cc-row { display:block; padding:5px 4px; border-radius:3px; cursor:pointer; font-size:13px; font-weight:normal; }
    #cc-panel .cc-row small { color:#666; display:block; margin-left:20px; }
    #cc-panel .cc-actions .btn { margin:0 6px 6px 0; }
  </style>

  {% if has_active %}
    <div class="cc-info-box">
      <strong>✅ Voucher Δημιουργήθηκε</strong>
      <table style="margin-top:6px;">
        <tr><td>AWB:</td><td><strong>{{ shipment.voucher_number|e }}</strong></td></tr>
        {% if shipment.tracking_number and shipment.tracking_number != shipment.voucher_number %}
        <tr><td>Tracking:</td><td>{{ shipment.tracking_number|e }}</td></tr>
        {% endif %}
        <tr><td>Υπηρεσία:</td><td>{{ service_label|e }}</td></tr>
      </table>
      {% if shipment.is_boxnow == '1' %}
      <div class="cc-locker-box">
        <strong>📦 BOX NOW Locker</strong><br>
        {% if shipment.locker_name %}<span>{{ shipment.locker_name|e }}</span><br>{% endif %}
        {% if shipment.locker_id %}<small style="color:#888;">ID: {{ shipment.locker_id|e }}</small>{% endif %}
      </div>
      {% endif %}
      {% if shipment.return_awb %}
      <div class="cc-return-awb">
        <strong>↩️ Επιστροφικό ({{ return_label|e }})</strong><br>
        Return AWB: <strong>{{ shipment.return_awb|e }}</strong>
      </div>
      {% endif %}
    </div>
    {% if shipment.status_desc %}
    <div class="cc-status {{ status_class|e }}">
      <strong>📍 {{ shipment.status_desc|e }}</strong>
      {% if shipment.status_updated_at %}<br><small>Τελ. ενημέρωση: {{ shipment.status_updated_at|e }}</small>{% endif %}
    </div>
    {% endif %}
    <div class="cc-actions">
      <a href="{{ url_download|e }}" class="btn btn-success btn-sm" target="_blank"><i class="fa fa-print"></i> Εκτύπωση Voucher (PDF)</a>
      {% if shipment.return_awb %}
      <a href="{{ url_download_return|e }}" class="btn btn-default btn-sm" target="_blank"><i class="fa fa-undo"></i> Επιστροφικό (PDF)</a>
      {% endif %}
      <button type="button" class="btn btn-info btn-sm" data-cc-action="status"><i class="fa fa-refresh"></i> Ανανέωση</button>
      <button type="button" class="btn btn-danger btn-sm" data-cc-action="void"><i class="fa fa-times"></i> Ακύρωση</button>
    </div>
  {% else %}
    {% if was_voided %}
    <div class="cc-voided">
      <strong>❌ Αποστολή Ακυρωμένη</strong><br>
      <span style="font-size:13px;">AWB: <del>{{ shipment.voucher_number|e }}</del></span>
    </div>
    <p style="font-size:12px; color:#666;">Μπορείς να δημιουργήσεις νέο voucher.</p>
    {% endif %}

    {% if locker_id and delivery_mode == 'pick' %}
    <div class="cc-locker-box" style="font-size:13px;">
      <strong>📦 BOX NOW Locker (επιλεγμένο από πελάτη)</strong><br>
      <span style="color:#2c6e35;">{{ locker_name ? locker_name|e : locker_id|e }}</span><br>
      <small style="color:#888;">ID: {{ locker_id|e }}</small>
    </div>
    <button type="button" class="btn btn-primary btn-sm btn-block" data-cc-action="create-boxnow" data-locker-id="{{ locker_id|e }}" data-locker-code="{{ locker_code|e }}" data-locker-name="{{ locker_name|e }}"><i class="fa fa-plus"></i> Δημιουργία BOX NOW Voucher</button>
    <button type="button" class="btn btn-warning btn-sm btn-block" data-cc-action="remove-boxnow">↩️ Αφαίρεση BOX NOW</button>
    {% elseif delivery_mode == 'auto' %}
    <div class="cc-locker-box" style="background:#fff8e1; border-color:#ffc107;">
      <strong>📦 BOX NOW — Αυτόματη εύρεση Locker</strong><br>
      <span style="font-size:12px; color:#7a6000;">Κοντινότερο διαθέσιμο BOX NOW Locker</span>
    </div>
    <button type="button" class="btn btn-primary btn-sm btn-block" data-cc-action="create-boxnow" data-locker-id="" data-locker-code="" data-locker-name=""><i class="fa fa-plus"></i> Δημιουργία BOX NOW Voucher</button>
    <button type="button" class="btn btn-warning btn-sm btn-block" data-cc-action="remove-boxnow">↩️ Αφαίρεση BOX NOW</button>
    {% else %}
    <p style="margin-bottom:10px; font-size:13px;">Δημιούργησε voucher για αυτή την παραγγελία:</p>
    <div class="cc-form-section">
      <span class="cc-label">📦 Υπηρεσία:</span>
      <select id="cc-service-type" class="form-control input-sm">
        <option value="next_day">Επόμενη Μέρα</option>
        <option value="same_day_3h">Αυθημερόν 3 ώρες</option>
        <option value="same_day_5h">Αυθημερόν 5 ώρες</option>
      </select>
    </div>
    <div class="cc-form-section">
      <span class="cc-label">📦 Πολλαπλά τεμάχια:</span>
      <label class="cc-row"><input type="checkbox" id="cc-multi-parcel"> Ενεργοποίηση πολλαπλών τεμαχίων</label>
      <div id="cc-parcel-wrap" style="display:none; margin-top:8px;">
        Αριθμός τεμαχίων: <input type="number" id="cc-parcel-count" value="2" min="2" max="99" class="form-control input-sm" style="width:80px; display:inline-block;">
      </div>
    </div>
    <div class="cc-form-section">
      <span class="cc-label">↩️ Επιστροφικό:</span>
      <label class="cc-row"><input type="radio" name="cc-return" value="none" checked> Χωρίς επιστροφικό</label>
      <label class="cc-row"><input type="radio" name="cc-return" value="optional"> <strong>Προαιρετικό</strong><small>Ο παραλήπτης μπορεί να το ενεργοποιήσει αργότερα</small></label>
      <label class="cc-row"><input type="radio" name="cc-return" value="mandatory"> <strong>Υποχρεωτικό</strong><small>Ο courier παραλαμβάνει επιστροφικό κατά την παράδοση</small></label>
    </div>
    <div class="cc-form-section">
      <label class="cc-row"><input type="checkbox" id="cc-boxnow"> <strong>📦 BOX NOW Locker</strong><small>Αυτόματη αναζήτηση σε ακτίνα 1.5km</small></label>
    </div>
    <button type="button" class="btn btn-primary btn-sm btn-block" data-cc-action="create"><i class="fa fa-plus"></i> Δημιουργία Voucher</button>
    {% endif %}
  {% endif %}
  <div class="cc-msg" style="margin-top:10px;"></div>
</div>
<script>
(function () {
  var panel = document.getElementById('cc-panel');
  if (!panel) return;
  var ORDER_ID = {{ order_id|json_encode }};
  var URLS = {create: {{ url_create|json_encode }}, void: {{ url_void|json_encode }}, status: {{ url_status|json_encode }}, removeBoxnow: {{ url_remove_bn|json_encode }}};

  function msg(type, text) {
    var box = panel.querySelector('.cc-msg');
    box.innerHTML = '';
    var d = document.createElement('div');
    d.className = 'alert alert-' + type;
    d.textContent = text;
    box.appendChild(d);
  }
  function post(url, params, done) {
    params.order_id = ORDER_ID;
    fetch(url, {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: new URLSearchParams(params).toString()})
      .then(function (r) { return r.text(); })
      .then(function (t) {
        var j = null;
        try { j = JSON.parse(t); } catch (e) {}
        if (!j) { msg('danger', 'Η σύνδεση έληξε ή ο server απάντησε με σφάλμα. Κάνε ανανέωση της σελίδας (F5) και ξαναδοκίμασε.'); return; }
        done(j);
      })
      .catch(function (e) { msg('danger', String(e)); });
  }
  function reloadOnTab() { window.location.hash = 'cc-tab'; window.location.reload(); }
  function create(params) {
    post(URLS.create, params, function (r) {
      if (r.success) { reloadOnTab(); return; }
      if (r.needs_override) { if (confirm(r.error)) { params.override = 1; create(params); } return; }
      msg('danger', r.error || 'Σφάλμα δημιουργίας voucher');
    });
  }
  panel.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('[data-cc-action]') : null;
    if (!b) return;
    var action = b.getAttribute('data-cc-action');
    if (action === 'create') {
      var multi = panel.querySelector('#cc-multi-parcel');
      var ret = panel.querySelector('input[name="cc-return"]:checked');
      create({
        service_type: panel.querySelector('#cc-service-type').value,
        parcel_count: multi && multi.checked ? parseInt(panel.querySelector('#cc-parcel-count').value || '2', 10) : 1,
        return_option: ret ? ret.value : 'none',
        boxnow: panel.querySelector('#cc-boxnow').checked ? 1 : 0
      });
    } else if (action === 'create-boxnow') {
      create({service_type: 'next_day', boxnow: 1, return_option: 'none', parcel_count: 1,
        locker_id: b.getAttribute('data-locker-id'), locker_code: b.getAttribute('data-locker-code'), locker_name: b.getAttribute('data-locker-name')});
    } else if (action === 'void') {
      if (confirm('Ακύρωση αποστολής;')) post(URLS.void, {}, function (r) { if (r.success) { reloadOnTab(); } else { msg('danger', r.error || 'Σφάλμα ακύρωσης'); } });
    } else if (action === 'status') {
      post(URLS.status, {}, function (r) { if (r.success) { reloadOnTab(); } else { msg('danger', r.error || 'Σφάλμα ανανέωσης'); } });
    } else if (action === 'remove-boxnow') {
      if (confirm('Αφαίρεση BOX NOW από αυτή την παραγγελία;')) post(URLS.removeBoxnow, {}, function (r) { if (r.success) { reloadOnTab(); } else { msg('danger', r.error || 'Σφάλμα αφαίρεσης BOX NOW'); } });
    }
  });
  var multi = panel.querySelector('#cc-multi-parcel');
  if (multi) multi.addEventListener('change', function () { panel.querySelector('#cc-parcel-wrap').style.display = this.checked ? '' : 'none'; });
  if (window.location.hash === '#cc-tab' && window.jQuery) {
    jQuery(function () { jQuery('a[href="#tab-courier-center"]').tab('show'); });
  }
})();
</script>
